{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coa.international/schemas/key-directory/v1/key-directory.schema.json",
  "title": "COA public key directory v1",
  "description": "Versioned directory of signing public keys, scoped by tenant (program_id) and role. Retired and compromised keys are retained indefinitely. Fetching the directory does NOT establish trust: verifiers must pin a fingerprint obtained out of band (docs/protocol/signed-record-v1.md section 5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "directory_version",
    "generated_at",
    "tenants"
  ],
  "properties": {
    "directory_version": {
      "const": "1"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "tenants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "program_id",
          "program_name",
          "roles"
        ],
        "properties": {
          "program_id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
          },
          "program_name": {
            "$ref": "https://coa.international/schemas/signed-record/v2.0/defs.schema.json#/$defs/display_text"
          },
          "roles": {
            "type": "object",
            "additionalProperties": false,
            "description": "Keys grouped by signer role. `laboratory` is reserved (spec section 8) and empty in release 1.",
            "required": [
              "tenant_signer"
            ],
            "properties": {
              "tenant_signer": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/key"
                }
              },
              "laboratory": {
                "type": "array",
                "maxItems": 0,
                "items": {
                  "$ref": "#/$defs/key"
                }
              }
            }
          }
        }
      }
    },
    "incidents": {
      "description": "Published key-status incidents (compromise notices) with affected scope.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "incident_id",
          "key_id",
          "published_at",
          "summary"
        ],
        "properties": {
          "incident_id": {
            "type": "string",
            "pattern": "^[!-~]{1,128}$"
          },
          "key_id": {
            "type": "string",
            "pattern": "^[!-~]{1,128}$"
          },
          "published_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "suspected_from": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  },
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "program_id",
        "role",
        "signer_id",
        "algorithm",
        "public_key",
        "fingerprint",
        "status",
        "environment",
        "created_at"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,126}[a-z0-9])?$"
        },
        "program_id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "role": {
          "enum": [
            "tenant_signer",
            "laboratory"
          ]
        },
        "signer_id": {
          "type": "string",
          "pattern": "^[!-~]{1,128}$"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "public_key": {
          "description": "Raw 32-byte Ed25519 public key, base64url without padding.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "fingerprint": {
          "description": "Lowercase hex SHA-256 of the raw 32-byte public key.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "active",
            "retired",
            "compromised"
          ]
        },
        "environment": {
          "enum": [
            "production",
            "demo",
            "development"
          ]
        },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "activated_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "retired_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "compromised_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "compromise_suspected_from": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    }
  }
}
